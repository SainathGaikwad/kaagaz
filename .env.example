# Copy to .env (never commit .env). Pick ONE provider.

# --- Option A: Meta's open-weight Muse Spark Open, served by Baseten (recommended) ---
# Key from https://app.baseten.co  -> API keys. Satisfies the hackathon's Meta-open-weight requirement.
MODEL_API_KEY=
KAAGAZ_BASE_URL=https://inference.baseten.co/v1
KAAGAZ_MODEL=meta-models/muse-spark-open

# --- Option B: Meta Model API (needs a card hold that Indian cards often decline) ---
# Key from https://dev.meta.ai -> API keys. If you use this, comment out the two KAAGAZ_ lines above.
# MODEL_API_KEY=
# KAAGAZ_BASE_URL=https://api.meta.ai/v1
# KAAGAZ_MODEL=muse-spark-1.3

# Optional: pin the structured-output mode if a provider needs it (auto by default)
# KAAGAZ_STRUCTURED=json_object
